# strongSwan 6.0.2 最简配置 - 完全按照 5.6.3 charon.conf 迁移
charon {
    duplicheck.enable = no
    
    dns1 = 8.8.8.8
    dns2 = 114.114.114.114
    
    # 日志配置 - 6.0.2 语法
    filelog {
        charon {
            path = /var/log/charon.log
            time_format = %b %e %T
            ike_name = yes
            append = no
            default = 1
            flush_line = yes
        }
        stderr {
            ike = 2
            knl = 3
        }
    }
    
    syslog {
        identifier = charon-custom
        daemon {
        }
        auth {
            default = -1
            ike = 0
        }
    }
}
