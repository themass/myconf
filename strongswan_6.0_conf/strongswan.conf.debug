# strongSwan 6.0.2 调试配置 - 最小化配置
# 用于排查启动问题

charon {
    # 基础设置
    load_modular = yes
    threads = 4
    
    # 端口设置
    port = 500
    port_nat_t = 4500
    
    # 重传设置
    retransmit_tries = 3
    retransmit_timeout = 4.0
    
    # 插件配置 - 最小化
    plugins {
        include strongswan.d/charon/*.conf
        
        # 只启用必要的插件
        attr {
            load = yes
        }
        resolve {
            load = yes
        }
        kernel-netlink {
            load = yes
        }
        socket-default {
            load = yes
        }
        vici {
            load = yes
            socket = /var/run/charon.vici
        }
        stroke {
            load = no
        }
        
        # 暂时禁用 EAP-RADIUS 插件进行测试
        # eap-radius {
        #     accounting = yes
        #     servers {
        #         radiusServer {
        #             secret = FreeVPN@vpn5296
        #             address = radius.sspacee.com
        #             auth_port = 1812
        #             acct_port = 1813
        #         }
        #     }
        # }
    }
    
    # 日志配置 - 详细日志
    filelog {
        charon {
            path = /var/log/strongswan.log
            time_format = %b %e %T
            ike_name = yes
            append = no
            default = 2
            flush_line = yes
        }
    }
    
    syslog {
        identifier = charon
        daemon {
            ike = 2
            knl = 2
        }
        auth {
            default = 2
        }
    }
}

include strongswan.d/*.conf
