# strongSwan 6.0.2 配置 - 基于官方文档标准
# 基于 5.6.3 配置迁移，保持相同的功能

connections {
    # 主要 RADIUS 连接 - 对应 5.6.3 的 radius 连接
    radius {
        local_addrs = %any
        remote_addrs = %any
        pools = radius-pool
        
        local {
            auth = pubkey
            certs = serverCert.pem
            id = {{SERVER_IP}}
        }
        remote {
            auth = eap-radius
            eap_id = %any
        }
        children {
            radius {
                local_ts = 0.0.0.0/0,::/0
                remote_ts = 10.0.0.0/24,fec3::/120
                # 使用与 5.6.3 相同的 ESP 算法
                esp_proposals = aes256-sha384-ecp384,aes128-sha1-modp2048,aes256-sha384-modp4096,aes256-sha1-modp4096,aes128-sha1-modp1536,aes256-sha384-modp2048,aes256-sha1-modp2048,aes128-sha1-modp1024,aes256-sha384-modp1536,aes256-sha1-modp1536,aes256-sha384-modp1024,aes256-sha1-modp1024
                # 启用压缩
                ipcomp = yes
                # 设置生存时间 - 对应 5.6.3 的 lifetime=8h
                life_time = 8h
                rekey_time = 30m
                # 启用流量统计
                mode = tunnel
                start_action = trap
            }
        }
        version = 2
        # 使用与 5.6.3 相同的 IKE 算法
        proposals = aes256-sha384-ecp384,aes128-sha1-modp2048,aes256-sha384-modp4096,aes256-sha1-modp4096,aes128-sha1-modp1536,aes256-sha384-modp2048,aes256-sha1-modp2048,aes128-sha1-modp1024,aes256-sha384-modp1536,aes256-sha1-modp1536,aes256-sha384-modp1024,aes256-sha1-modp1024
        # 启用 NAT 穿透
        encap = yes
        # DPD 设置 - 对应 5.6.3 的 dpdaction=restart, dpddelay=20
        dpd_delay = 20s
        dpd_timeout = 60s
        dpd_action = restart
        # 重密钥设置 - 对应 5.6.3 的 ikelifetime=8h
        rekey_time = 8h
        reauth_time = 8h
    }
    
    # 第二个 RADIUS 连接 - 对应 5.6.3 的 radius-3 连接
    radius-3 {
        local_addrs = %any
        remote_addrs = %any
        pools = radius3-pool
        
        local {
            auth = pubkey
            certs = serverCert3.pem
            id = 154.22.124.96
        }
        remote {
            auth = eap-radius
            eap_id = %any
        }
        children {
            radius-3 {
                local_ts = 0.0.0.0/0,::/0
                remote_ts = 10.3.0.0/24,fec3::/120
                # 使用与 5.6.3 相同的 ESP 算法
                esp_proposals = aes256-sha384-ecp384,aes128-sha1-modp2048,aes256-sha384-modp4096,aes256-sha1-modp4096,aes128-sha1-modp1536,aes256-sha384-modp2048,aes256-sha1-modp2048,aes128-sha1-modp1024,aes256-sha384-modp1536,aes256-sha1-modp1536,aes256-sha384-modp1024,aes256-sha1-modp1024
                # 启用压缩
                ipcomp = yes
                # 设置生存时间
                life_time = 8h
                rekey_time = 30m
                # 启用流量统计
                mode = tunnel
                start_action = trap
            }
        }
        version = 2
        # 使用与 5.6.3 相同的 IKE 算法
        proposals = aes256-sha384-ecp384,aes128-sha1-modp2048,aes256-sha384-modp4096,aes256-sha1-modp4096,aes128-sha1-modp1536,aes256-sha384-modp2048,aes256-sha1-modp2048,aes128-sha1-modp1024,aes256-sha384-modp1536,aes256-sha1-modp1536,aes256-sha384-modp1024,aes256-sha1-modp1024
        # 启用 NAT 穿透
        encap = yes
        # DPD 设置
        dpd_delay = 20s
        dpd_timeout = 60s
        dpd_action = restart
        # 重密钥设置
        rekey_time = 8h
        reauth_time = 8h
        # 端口设置 - 对应 5.6.3 的 rightikeport=8080
        remote_port = 8080
    }
}

authorities {
    # CA 证书 - 对应 5.6.3 的 leftca=caCert.pem
    ca {
        cacert = caCert.pem
    }
    ca3 {
        cacert = caCert3.pem
    }
}

pools {
    # IP 地址池 - 对应 5.6.3 的 rightsourceip
    radius-pool {
        addrs = 10.0.0.0/24
        dns = 8.8.8.8, 114.114.114.114
    }
    radius3-pool {
        addrs = 10.3.0.0/24
        dns = 8.8.8.8, 114.114.114.114
    }
}

secrets {
    # 私钥 - 对应 5.6.3 的 : RSA serverKey.pem
    private-strongswan {
        file = serverKey.pem
    }
    private-strongswan3 {
        file = serverKey3.pem
    }
}