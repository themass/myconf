# strongSwan 6.0.2 swanctl 配置文件
# 默认端口配置 (500/4500)

connections {
    # IKEv2 EAP 连接
    ikev2-eap {
        local_addrs = %any
        remote_addrs = %any
        
        local {
            auth = eap-radius
            id = {{SERVER_IP}}
        }
        remote {
            auth = eap-radius
            eap_id = %any
        }
        children {
            ikev2-eap {
                local_ts = 10.0.0.0/24
                remote_ts = 0.0.0.0/0
                esp_proposals = aes256-sha256-modp2048,aes128-sha256-modp2048
            }
        }
        version = 2
        proposals = aes256-sha256-modp2048,aes128-sha256-modp2048
        dpd_action = restart
        close_action = restart
        rekey_time = 4h
        rekey_bytes = 100m
        rekey_packets = 1000000
        fragmentation = yes
        dpd_delay = 30s
        dpd_timeout = 150s
    }
    
    # IKEv2 证书连接
    ikev2-cert {
        local_addrs = %any
        remote_addrs = %any
        
        local {
            auth = pubkey
            certs = serverCert.pem
            id = {{SERVER_IP}}
        }
        remote {
            auth = pubkey
            id = %any
        }
        children {
            ikev2-cert {
                local_ts = 10.0.1.0/24
                remote_ts = 0.0.0.0/0
                esp_proposals = aes256-sha256-modp2048,aes128-sha256-modp2048
            }
        }
        version = 2
        proposals = aes256-sha256-modp2048,aes128-sha256-modp2048
        dpd_action = restart
        close_action = restart
        rekey_time = 4h
        rekey_bytes = 100m
        rekey_packets = 1000000
        fragmentation = yes
        dpd_delay = 30s
        dpd_timeout = 150s
    }
}

authorities {
    # CA 证书
    strongswan {
        cacert = caCert.pem
        crl_uris = http://crl.strongswan.org/strongswan.crl
    }
}

pools {
    # IP 地址池
    ikev2 {
        addrs = 10.0.0.0/24
        dns = 8.8.8.8, 8.8.4.4
    }
}

secrets {
    # 私钥
    private-strongswan {
        file = private/serverKey.pem
    }
    private-strongswan-cert {
        file = private/serverKey.pem
    }
}
