#!/bin/sh -e
#
# /etc/rc.local：开机最后执行。
#
# 防火墙和 NAT 规则不在这里写。它们由 `vpn.sh system iptables-ipsec` 按当前出口网卡
# 添加，并由 iptables-persistent（netfilter-persistent）在开机时恢复。
# 这里写死网卡名或重复 -A 规则，会在网卡名不一致时指向不存在的网卡，并让规则重复。
#
# 需要开机额外执行的命令写在 exit 0 之前。

# 开机时确保转发打开（sysctl 文件是持久的，这一行只是双保险）
sysctl -q -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true

exit 0
