# MySQL 8.0 服务端配置，由 infra.sh mysql 渲染到 /etc/mysql/mysql.conf.d/zz-vpn.cnf
#
# 为什么放在 mysql.conf.d 而不是 conf.d：
#   /etc/mysql/my.cnf 里的 include 顺序是
#     !includedir /etc/mysql/conf.d/
#     !includedir /etc/mysql/mysql.conf.d/
#   MySQL 后加载的配置覆盖先加载的。放在 conf.d 里会被 mysql.conf.d/mysqld.cnf
#   的 bind-address = 127.0.0.1 覆盖掉（实测过：配置写的是内网地址，实际只听 127.0.0.1）。
#   文件名 zz-vpn.cnf 排在 mysqld.cnf 之后，同名项以本文件为准。
#
# 为什么不整份替换 my.cnf：
#   /etc/mysql/my.cnf 是符号链接，包自带的默认值在 mysql.conf.d/mysqld.cnf。
#   整份替换会和包管理打架（升级被覆盖、debian-sys-maint 丢失）。
#   这里只放差异项。
#
# 改这些值：改本文件再跑 bash infra.sh mysql，不要直接改服务器上的 zz-vpn.cnf。

[mysqld]
user = mysql
port = 6666
# 由脚本替换为本机内网地址；INFRA_MYSQL_PUBLIC=1 时为 0.0.0.0。
bind-address = innerip
datadir = /var/lib/mysql
socket = /var/run/mysqld/mysqld.sock
pid-file = /var/run/mysqld/mysqld.pid

# ------------------------------------------------------------------ 8.0 的关键项

# 表名大小写：8.0 起这个值只能在数据目录初始化之前设定，初始化后改会直接启动失败。
# 老库（5.6）是大小写不敏感，所以取 1。改这个值等于重建实例，不是改配置。
lower_case_table_names = 1

# 老客户端（5.6 时代的驱动、旧版 mysql/mysqldump）不认 8.0 默认的 caching_sha2_password，
# 会报 "Authentication plugin 'caching_sha2_password' cannot be loaded"。
# 8.0 里还能退回 mysql_native_password；8.4 起该插件被移除，到那时要升级客户端。
default_authentication_plugin = mysql_native_password

# 原配置是 utf8（= utf8mb3）。8.0 里 utf8mb3 已弃用但仍可用，
# 为了和现有数据一致先保持；新项目建议改成 utf8mb4。
character_set_server = utf8mb3
collation_server = utf8mb3_general_ci

# SQL 模式必须和老库（5.6/5.7）一致：STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION。
#
# 不要用 sql-mode = ANSI。MySQL 5.7 起把 ONLY_FULL_GROUP_BY 也并进了 ANSI 组合，
# 8.0 里这一项会让大量老 SQL 直接报错。实测报错：
#   select * from vpn.videochannel_1 where enable=1 and channelType=? group by channel order by id desc
#   Expression #1 of SELECT list is not in GROUP BY clause ... incompatible with sql_mode=only_full_group_by
# 老库里这条 SQL 一直是能跑的（旧机 sql_mode 就是下面这行）。
sql-mode = STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION

# ------------------------------------------------------------------ 容量与性能

max_connections = 151
max_allowed_packet = 32M

innodb_buffer_pool_size = 256M
innodb_log_file_size = 128M
innodb_flush_log_at_trx_commit = 1
innodb_file_per_table = 1
innodb_lock_wait_timeout = 50

# ------------------------------------------------------------------ binlog

log-bin = mysql-bin
binlog_format = ROW
server-id = 1
# 5.6 的 expire_logs_days 在 8.0 已弃用，换成秒。
binlog_expire_logs_seconds = 86400

[mysqldump]
quick
max_allowed_packet = 32M
