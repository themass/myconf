# strongSwan 6.0.2 最基础配置
# 只包含最基本的设置

charon {
    load_modular = yes
    threads = 16
    port = 500
    port_nat_t = 4500
    
    plugins {
        include strongswan.d/charon/*.conf
    }
    
    filelog {
        charon {
            path = /var/log/charon.log
            time_format = %b %e %T
            ike_name = yes
            append = no
            default = 1
            flush_line = yes
        }
    }
    
    syslog {
        identifier = charon
        daemon {
            ike = 2
            knl = 2
        }
        auth {
            default = 2
        }
    }
}

include strongswan.d/*.conf
