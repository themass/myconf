{
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-reality",
      "listen": "{{LISTEN}}",
      "listen_port": {{PORT}},
      "users": [
        {
          "uuid": "{{UUID}}",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "{{SNI}}",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "{{DEST_HOST}}",
            "server_port": {{DEST_PORT}}
          },
          "private_key": "{{PRIVATE_KEY}}",
          "short_id": [
            "{{SHORT_ID}}"
          ]
        }
      }
    }
  ]
}
