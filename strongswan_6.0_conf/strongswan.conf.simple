# strongSwan 6.0.2 配置文件 - 基于 5.6.3 配置
# 完全按照你的 5.6.3 charon.conf 迁移

charon {
    # 基础设置
    load_modular = yes
    threads = 16
    
    # 端口设置
    port = 500
    port_nat_t = 4500
    
    # 重传设置
    retransmit_tries = 3
    retransmit_timeout = 4.0
    
    # 重密钥设置
    rekey_time = 4h
    rekey_bytes = 100m
    rekey_packets = 1000000
    reauth_time = 0
    
    # 其他设置
    close_action = none
    send_vendor_id = yes
    
    # 插件配置 - 最小化，只包含必要的
    plugins {
        include strongswan.d/charon/*.conf
        
        # 只启用最基本的插件
        attr {
            load = yes
        }
        resolve {
            load = yes
        }
        kernel-netlink {
            load = yes
        }
        socket-default {
            load = yes
        }
        vici {
            load = yes
        }
        stroke {
            load = no
        }
        
        # EAP-RADIUS 插件 - 保持你的原有配置
        eap-radius {
            accounting = yes
            servers {
                radiusServer {
                    secret = FreeVPN@vpn5296
                    address = radius.sspacee.com
                    auth_port = 1812
                    acct_port = 1813
                }
            }
        }
    }
    
    # 日志配置 - 完全按照你的 5.6.3 配置
    filelog {
        /var/log/charon.log {
            time_format = %b %e %T
            ike_name = yes
            append = no
            default = 1
            flush_line = yes
        }
        stderr {
            ike = 2
            knl = 3
        }
    }
    
    syslog {
        identifier = charon-custom
        daemon {
        }
        auth {
            default = -1
            ike = 0
        }
    }
}

include strongswan.d/*.conf
