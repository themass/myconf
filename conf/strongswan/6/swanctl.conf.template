# strongSwan 6.x — IKEv2 + EAP-RADIUS
# 服务器 IP、地址池由 vpn.sh strongswan config 填入：IP 自动识别（SERVER_ADDRESS 可覆盖），地址池取 IPSEC_SUBNET / IPSEC_SUBNET6。
# RADIUS 在 strongswan.conf 的 eap-radius 插件中配置。

connections {
    radius {
        version = 2
        local_addrs = %any
        remote_addrs = %any
        pools = radius
        send_certreq = no
        mobike = no
        encap = yes
        dpd_delay = 20s

        local {
            auth = pubkey
            certs = serverCert.pem
            id = {{SERVER_IP}}
        }
        remote {
            auth = eap-radius
            eap_id = %any
        }
        children {
            radius {
                # 客户端一侧只能是分给它的虚拟地址（dynamic，不写就是这个）。
                # 写成 remote_ts = 0.0.0.0/0 时，隧道一建立，服务器内核里就多了一条
                # "发往任何地址都走这条隧道"的策略：服务器自己的 SSH 回包、RADIUS、DNS 全被塞进
                # 手机的隧道，整台服务器失联，手机也收不到最后一个 IKE_AUTH 应答。
                local_ts = 0.0.0.0/0, ::/0
                start_action = none
                dpd_action = restart
                rekey_time = 8h
            }
        }
        proposals = aes256-sha256-ecp256, aes128-sha256-ecp256, aes256-sha384-ecp256, aes256gcm16-prfsha256-ecp256, aes256-sha384-ecp384, aes128-sha1-modp2048, aes256-sha384-modp4096, aes256-sha1-modp4096, aes128-sha1-modp1536, aes256-sha384-modp2048, aes256-sha1-modp2048, aes128-sha1-modp1024, aes256-sha384-modp1536, aes256-sha1-modp1536, aes256-sha384-modp1024, aes256-sha1-modp1024
        rekey_time = 8h
    }
}

authorities {
    ca {
        cacert = caCert.pem
    }
}

pools {
    radius {
        addrs = {{POOL4}}, {{POOL6}}
    }
}

# 私钥放在 private/serverCert.pem，与 x509/serverCert.pem 同名以便 charon 自动配对