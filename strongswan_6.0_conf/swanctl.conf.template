# strongSwan 6.x — IKEv2 + EAP-RADIUS（与 5.6.3 strongswan_conf 一致）
# {{SERVER_IP}} 由 vpn_setup.sh 自动替换；RADIUS 在 strongswan.conf 的 eap-radius 插件中配置

connections {
    radius {
        version = 2
        local_addrs = %any
        remote_addrs = %any
        pools = radius
        send_certreq = no
        dpd_delay = 20s
        dpd_action = restart

        local {
            auth = pubkey
            certs = serverCert.pem
            id = {{SERVER_IP}}
        }
        remote {
            auth = eap-radius
            eap_id = %any
        }
        children {
            radius {
                local_ts = 0.0.0.0/0, ::/0
                remote_ts = 0.0.0.0/0, ::/0
                start_action = none
                rekey_time = 8h
            }
        }
        proposals = aes256-sha256-ecp256, aes128-sha256-ecp256, aes256-sha384-ecp256, aes256gcm16-prfsha256-ecp256, aes256-sha384-ecp384, aes128-sha1-modp2048, aes256-sha384-modp4096, aes256-sha1-modp4096, aes128-sha1-modp1536, aes256-sha384-modp2048, aes256-sha1-modp2048, aes128-sha1-modp1024, aes256-sha384-modp1536, aes256-sha1-modp1536, aes256-sha384-modp1024, aes256-sha1-modp1024
        rekey_time = 8h
    }
}

authorities {
    ca {
        cacert = caCert.pem
    }
}

pools {
    radius {
        addrs = 10.0.0.0/24, fec3::/120
    }
}

# 私钥放在 private/serverCert.pem，与 x509/serverCert.pem 同名以便 charon 自动配对