# strongSwan 6.0.2 最小配置 - 基于 5.6.3 版本算法支持
# 支持多种算法，兼容性更好

connections {
    # 基于 5.6.3 的 radius 连接配置
    radius {
        local_addrs = %any
        remote_addrs = %any
        pools = radius-pool
        
        local {
            auth = pubkey
            certs = serverCert.pem
            id = {{SERVER_IP}}
        }
        remote {
            auth = eap-radius
            eap_id = %any
        }
        children {
            radius {
                local_ts = 0.0.0.0/0,::/0
                remote_ts = 10.0.0.0/24,fec3::/120
                # 使用与 5.6.3 相同的 ESP 算法
                esp_proposals = aes256-sha384-ecp384,aes128-sha1-modp2048,aes256-sha384-modp4096,aes256-sha1-modp4096,aes128-sha1-modp1536,aes256-sha384-modp2048,aes256-sha1-modp2048,aes128-sha1-modp1024,aes256-sha384-modp1536,aes256-sha1-modp1536,aes256-sha384-modp1024,aes256-sha1-modp1024
                life_time = 8h
                rekey_time = 30m
                mode = tunnel
                start_action = trap
            }
        }
        version = 2
        # 使用与 5.6.3 相同的 IKE 算法
        proposals = aes256-sha384-ecp384,aes128-sha1-modp2048,aes256-sha384-modp4096,aes256-sha1-modp4096,aes128-sha1-modp1536,aes256-sha384-modp2048,aes256-sha1-modp2048,aes128-sha1-modp1024,aes256-sha384-modp1536,aes256-sha1-modp1536,aes256-sha384-modp1024,aes256-sha1-modp1024
        encap = yes
        # DPD 设置 - 对应 5.6.3 的 dpdaction=restart, dpddelay=20
        dpd_delay = 20s
        dpd_timeout = 60s
        dpd_action = restart
        # 重密钥设置 - 对应 5.6.3 的 ikelifetime=8h
        rekey_time = 8h
        reauth_time = 8h
    }
}

authorities {
    ca {
        cacert = caCert.pem
    }
}

pools {
    # IP 地址池 - 对应 5.6.3 的 rightsourceip
    radius-pool {
        addrs = 10.0.0.0/24
        dns = 8.8.8.8, 114.114.114.114
    }
}

secrets {
    private-strongswan {
        file = serverKey.pem
    }
}
