# strongSwan 6.0.2 测试配置 - 最简配置
charon {
    # 只包含最基本的配置
    dns1 = 8.8.8.8
    dns2 = 114.114.114.114
    
    # 日志配置
    filelog {
        charon {
            path = /var/log/charon.log
            time_format = %b %e %T
            ike_name = yes
            append = no
            default = 1
            flush_line = yes
        }
    }
    
    # 系统日志配置
    syslog {
        identifier = charon
        daemon {
            ike = 2
            knl = 2
        }
        auth {
            default = 2
        }
    }
}
