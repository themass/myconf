# strongSwan 6.0.2 极简配置 - 用于测试启动
charon {
    load_modular = yes
    threads = 4
    
    # 端口设置
    port = 8081
    port_nat_t = 8080
    
    # 插件配置 - 只包含基本插件
    plugins {
        include strongswan.d/charon/*.conf
    }
    
    # 日志配置
    filelog {
        charon {
            path = /var/log/charon.log
            time_format = %b %e %T
            ike_name = yes
            append = no
            default = 2
            flush_line = yes
        }
    }
}

include strongswan.d/*.conf
