# 口令文件模板 —— 这个文件不进 git（.gitignore 里的 .env 规则覆盖它）。
#
# 当前 conf/postgres/init.sql 是直接写口令的，所以这个文件默认用不到。
# 只有在把 init.sql 改成从文件读取口令时才需要：
#
#   cp conf/postgres/.env.example conf/postgres/.env
#   chmod 600 conf/postgres/.env
#   把下面的占位换成真实口令
#
# 解析方式只读这一行，不 source 文件，所以文件里出现命令也不会被执行。

PG_SUPER_PASSWORD='<超级用户 root / sspacee 的口令>'
