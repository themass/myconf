# OCR service credentials
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_ACCESS_KEY_SECRET=

# LLM service configuration
LLM_API_KEY=
LLM_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=deepseek-v4-1-flash

# fleet.sh（shell/fleet.sh）：机器清单和账号。真实值写进 .env，该文件不进 git。
FLEET_USER=root
FLEET_PASSWORD=
# 个别机器密码不同时：FLEET_PASSWORD_<ip 的点换成下划线>=
FLEET_REMOTE_DIR=/root/work/myconf
FLEET_BRANCH=
# 每行 ip:ssh端口:角色，端口留空按 22。角色: nginx radius infra login app vpn
FLEET_HOSTS="
203.0.113.10:22:vpn
203.0.113.20:2222:infra,radius
"
