# strongSwan 6.0.2 最小化配置 - 用于调试启动问题
charon {
    load_modular = yes
    threads = 4
    
    # 端口设置
    port = 8081
    port_nat_t = 8080
    
    # 插件配置 - 最小化
    plugins {
        include strongswan.d/charon/*.conf
        
        # 只启用必要的插件
        attr {
            load = yes
        }
        resolve {
            load = yes
        }
        kernel-netlink {
            load = yes
        }
        socket-default {
            load = yes
        }
        vici {
            load = yes
        }
        updown {
            load = yes
        }
        eap-identity {
            load = yes
        }
        eap-radius {
            load = yes
            accounting = yes
            servers {
                radiusServer {
                    secret = FreeVPN@vpn5296
                    address = radius.sspacee.com
                    auth_port = 1812
                    acct_port = 1813
                }
            }
        }
    }
    
    # 日志配置 - 详细日志
    filelog {
        charon {
            path = /var/log/charon.log
            time_format = %b %e %T
            ike_name = yes
            append = no
            default = 2
            flush_line = yes
        }
        stderr {
            ike = 2
            knl = 2
            cfg = 2
        }
    }
}

include strongswan.d/*.conf
