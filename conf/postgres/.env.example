# 本地口令文件 —— 这个文件不进 git（.gitignore 里的 .env 规则覆盖它）。
#
# 用法:
#   cp conf/postgres/.env.example conf/postgres/.env
#   chmod 600 conf/postgres/.env
#   把下面的占位换成真实口令
#
# 这里的变量只由 bash vpn.sh postgres roles 读取（只解析这一行，不执行文件内容），
# 不会出现在命令行参数、日志或提交里。仓库里永远只保留本示例文件。

PG_SUPER_PASSWORD='<超级用户 root / sspacee 的口令>'
