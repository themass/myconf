{
  "log": { "loglevel": "warning" },
  "inbounds": [{
    "listen": "127.0.0.1",
    "port": {{SOCKS_PORT}},
    "protocol": "socks",
    "settings": { "udp": true }
  }],
  "outbounds": [{
    "protocol": "vless",
    "settings": {
      "vnext": [{
        "address": "127.0.0.1",
        "port": {{PORT}},
        "users": [{
          "id": "{{UUID}}",
          "encryption": "none",
          "flow": "xtls-rprx-vision"
        }]
      }]
    },
    "streamSettings": {
      "network": "tcp",
      "security": "reality",
      "realitySettings": {
        "serverName": "{{SERVER_NAME}}",
        "publicKey": "{{PUBLIC_KEY}}",
        "shortId": "{{SHORT_ID}}",
        "fingerprint": "chrome"
      }
    }
  }]
}
